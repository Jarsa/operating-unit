<odoo>
    <record id="stock_location_route_view_form" model="ir.ui.view">
        <field name="name">stock.location.route.view.form</field>
        <field name="model">stock.location.route</field>
        <field
            name="inherit_id"
            ref="sale_stock.stock_location_route_view_form_inherit_sale_stock"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_ids']" position="after">
                <field
                    name="operating_unit_ids"
                    string="Operating Units"
                    widget="many2many_tags"
                />
            </xpath>
        </field>
    </record>
</odoo>
