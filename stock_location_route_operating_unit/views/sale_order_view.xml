<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="1000" />
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form/group/group/field[@name='route_id']"
                position="replace"
            >
                <field name="operating_unit_id" invisible="1" />
                <field
                    name="route_id"
                    groups="stock.group_adv_location"
                    options="{'no_create': True}"
                    domain="[('sale_selectable', '=', True), '|', ('operating_unit_ids', 'in', operating_unit_id), ('operating_unit_ids', '=', False)]"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='route_id']"
                position="replace"
            >
                <field name="operating_unit_id" invisible="1" />
                <field
                    name="route_id"
                    groups="stock.group_adv_location"
                    options="{'no_create': True}"
                    optional="hide"
                    domain="[('sale_selectable', '=', True), '|', ('operating_unit_ids', 'in', operating_unit_id), ('operating_unit_ids', '=', False)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
